  "fixed_sql": [
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL CHECK (id = 1), \"theme_mode\" TEXT NOT NULL CHECK (theme_mode IN ('system', 'light', 'dark')), \"locale_tag\" TEXT NOT NULL CHECK (locale_tag = 'ar'), \"created_at_utc\" TEXT NOT NULL, \"updated_at_utc\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL CHECK (revision >= 0), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"code\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"unit_price_piastres\" INTEGER NOT NULL CHECK (unit_price_piastres >= 0), \"normalized_search_text\" TEXT NOT NULL, \"barcode\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "quotations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quotations\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"reference_number\" TEXT NOT NULL UNIQUE, \"customer_name\" TEXT NOT NULL, \"customer_phone\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'draft', \"issue_date\" INTEGER NOT NULL, \"valid_until\" INTEGER NULL, \"notes\" TEXT NULL, \"subtotal_piastres\" INTEGER NOT NULL DEFAULT 0 CHECK (subtotal_piastres >= 0), \"discount_piastres\" INTEGER NOT NULL DEFAULT 0 CHECK (discount_piastres >= 0), \"tax_piastres\" INTEGER NOT NULL DEFAULT 0 CHECK (tax_piastres >= 0), \"grand_total_piastres\" INTEGER NOT NULL DEFAULT 0 CHECK (grand_total_piastres >= 0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "quotation_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quotation_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"quotation_id\" INTEGER NOT NULL REFERENCES quotations(id) ON DELETE CASCADE, \"product_id\" INTEGER NULL REFERENCES products (id) ON DELETE SET NULL, \"product_code\" TEXT NOT NULL, \"product_name\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"unit_price_piastres\" INTEGER NOT NULL CHECK (unit_price_piastres >= 0), \"quantity\" INTEGER NOT NULL CHECK (quantity > 0), \"line_discount_piastres\" INTEGER NOT NULL DEFAULT 0 CHECK (line_discount_piastres >= 0), \"line_total_piastres\" INTEGER NOT NULL CHECK (line_total_piastres >= 0));"
        }
      ]
    },
    {
      "name": "invoices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoices\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"reference_number\" TEXT NOT NULL UNIQUE, \"quotation_id\" INTEGER NULL REFERENCES quotations (id) ON DELETE SET NULL, \"customer_name\" TEXT NOT NULL, \"customer_phone\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'unpaid', \"issue_date\" INTEGER NOT NULL, \"due_date\" INTEGER NULL, \"notes\" TEXT NULL, \"subtotal_piastres\" INTEGER NOT NULL DEFAULT 0, \"discount_piastres\" INTEGER NOT NULL DEFAULT 0, \"tax_piastres\" INTEGER NOT NULL DEFAULT 0, \"grand_total_piastres\" INTEGER NOT NULL DEFAULT 0, \"paid_amount_piastres\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "invoice_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"invoice_id\" INTEGER NOT NULL REFERENCES invoices (id) ON DELETE CASCADE, \"product_id\" INTEGER NULL REFERENCES products (id) ON DELETE SET NULL, \"product_code\" TEXT NOT NULL, \"product_name\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"unit_price_piastres\" INTEGER NOT NULL, \"quantity\" INTEGER NOT NULL, \"line_discount_piastres\" INTEGER NOT NULL DEFAULT 0, \"line_total_piastres\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "invoice_payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_payments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"invoice_id\" INTEGER NOT NULL REFERENCES invoices (id) ON DELETE CASCADE, \"amount_piastres\" INTEGER NOT NULL, \"payment_method\" TEXT NOT NULL DEFAULT 'cash', \"payment_date\" INTEGER NOT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
